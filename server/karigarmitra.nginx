# /etc/nginx/sites-available/karigarmitra   (replace karigarmitra.in with your domain)
server {
    listen 80;
    server_name karigarmitra.in www.karigarmitra.in;

    root /var/www/karigarmitra;          # index.html, sw.js, manifest.json, icons/
    index index.html;

    location = /sw.js { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location /api/km/ {                  # admin counters (gunicorn on port 5001)
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 1m;
    }
    location / { try_files $uri $uri/ /index.html; }
}
